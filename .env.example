# Copie ce fichier en .env et renseigne les valeurs. NE JAMAIS committer .env.

# Secret de session (chaîne aléatoire longue). Ex : openssl rand -hex 32
SECRET_KEY=change-me-in-production

# Port d'écoute. En prod Infomaniak, la variable PORT est fournie automatiquement.
PORT=3000

# Base de données.
# - Local (défaut si absent) : SQLite dans instance/paname.sqlite
# - Prod MariaDB — DEUX façons (les variables séparées sont prioritaires) :
#
#   (recommandé) variables séparées — mot de passe pris TEL QUEL, même avec
#   des caractères spéciaux (@ : / …), aucun encodage nécessaire :
# DB_HOST=8u0rgw.myd.infomaniak.com
# DB_PORT=3306
# DB_NAME=8u0rgw_pnmpnd
# DB_USER=8u0rgw_jdvs22
# DB_PASSWORD=ton-mot-de-passe-avec-caractères-spéciaux
#
#   (alternative) une seule URL — le mot de passe doit être URL-encodé :
# DATABASE_URL=mysql://user:pass@host:3306/base

# Mettre à "true" pour voir les requêtes SQL en console.
SQL_LOG=false

# Compte admin créé automatiquement au 1er démarrage si la base n'a aucun utilisateur.
# Pratique en prod sans accès shell. Choisis un mot de passe fort.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PRENOM=Admin
