# Copie ce fichier en .env et renseigne les valeurs. NE JAMAIS committer .env.

# Secret de session (chaîne aléatoire longue). Ex : openssl rand -hex 32
SECRET_KEY=change-me-in-production

# Port d'écoute. En prod Infomaniak, la variable PORT est fournie automatiquement.
PORT=3000

# Base de données.
# - Local (défaut si absent) : SQLite dans instance/paname.sqlite
# - Prod MariaDB Infomaniak :
#   DATABASE_URL=mysql://8u0rgw_jdvs22:MOTDEPASSE@8u0rgw.myd.infomaniak.com:3306/8u0rgw_pnmpnd
# DATABASE_URL=

# Mettre à "true" pour voir les requêtes SQL en console.
SQL_LOG=false
