# Copie ce fichier en .env et renseigne les valeurs. NE JAMAIS committer .env.

# Secret de session — OBLIGATOIRE en production, 32 caractères minimum.
# Génère-le avec : openssl rand -hex 32
SECRET_KEY=change-me-in-production

# WebAuthn / passkeys. Par défaut, dérivé du domaine de la requête ; à fixer
# explicitement en production pour figer le domaine des passkeys.
# WEBAUTHN_RP_ID=paname-panade.fr
# WEBAUTHN_ORIGIN=https://paname-panade.fr

# Port d'écoute. En prod Infomaniak, la variable PORT est fournie automatiquement.
PORT=3000

# Origine publique du site. Fige le domaine des URL canoniques, du sitemap et
# des balises Open Graph. Sans elle, l'origine est déduite de chaque requête —
# suffisant tant que le site n'est servi que par un seul domaine.
# SITE_URL=https://paname-panade.fr

# Base de données.
# - Local (défaut si absent) : SQLite dans instance/paname.sqlite
# - Prod MariaDB — DEUX façons (les variables séparées sont prioritaires) :
#
#   (recommandé) variables séparées — mot de passe pris TEL QUEL, même avec
#   des caractères spéciaux (@ : / …), aucun encodage nécessaire :
# DB_HOST=8u0rgw.myd.infomaniak.com
# DB_PORT=3306
# DB_NAME=8u0rgw_pnmpnd
# DB_USER=8u0rgw_jdvs22
# DB_PASSWORD=ton-mot-de-passe-avec-caractères-spéciaux
#
#   (alternative) une seule URL — le mot de passe doit être URL-encodé :
# DATABASE_URL=mysql://user:pass@host:3306/base

# Connexion Google (facultative). Sans ces deux valeurs, le bouton
# « Continuer avec Google » n'apparaît pas et le reste de l'authentification
# fonctionne normalement.
# À créer sur https://console.cloud.google.com/apis/credentials :
#   type « ID client OAuth » -> « Application Web »
#   URI de redirection autorisé : https://<ton-domaine>/api/auth/callback/google
#   (en local : http://localhost:3000/api/auth/callback/google)
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=

# Mettre à "true" pour voir les requêtes SQL en console.
SQL_LOG=false

# Compte admin créé automatiquement au 1er démarrage si la base n'a aucun utilisateur.
# Pratique en prod sans accès shell. Choisis un mot de passe fort.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PRENOM=Admin
