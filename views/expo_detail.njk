{% extends "base.njk" %}
{% from "_macros.njk" import stars %}
{% block title %}{{ expo.title }} | Paname Panade{% endblock %}
{% block head %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
{% endblock %}
{% block content %}
<div class="container py-5">
  <a href="{{ url_for('main.expos') }}" class="muted small">← Toutes les expos</a>

  <div class="row mt-2">
    <div class="col-lg-7">
      {% set price = price_for(expo, current_user) %}
      <span class="badge {{ 'badge-free' if price.free else 'badge-paid' }} mb-2">{{ price.label|upper }}</span>
      <h1>{{ expo.title }}</h1>
      {% if expo.museum %}
        <p class="muted">à <a href="{{ url_for('main.museum_detail', slug=expo.museum.slug) }}">{{ expo.museum.name }}</a></p>
      {% endif %}

      {% if expo.avg_rating %}
        <p class="mb-3">{{ stars(expo.avg_rating|round|int) }}
          <strong>{{ expo.avg_rating }}/5</strong>
          <span class="muted small">({{ expo.rating_count }} avis)</span></p>
      {% endif %}

      {% set img = img_url(expo.image) %}
      {% if img %}
        {# Ratio fixé en CSS + width/height : la hauteur est connue avant le
           chargement. Image principale de la page, donc chargée sans délai. #}
        <div class="card-img-wrap expo-hero mb-3">
          <img src="{{ img }}" alt="{{ expo.title }}" width="1200" height="800"
               loading="eager" fetchpriority="high" decoding="async">
          {% if expo.is_permanent %}<span class="img-tag">Exposition permanente</span>{% endif %}
        </div>
      {% endif %}

      {# Ligne éditoriale propre au site : évite une fiche 100 % dupliquée du
         jeu de données de la Ville de Paris. #}
      <p class="expo-angle">{{ expo.editorial_note }}</p>

      {% if expo.description_text %}
        <div class="expo-description">{{ expo.description_text }}</div>
      {% endif %}

      {% if other_sessions %}
        <div class="stat-tile text-start mt-4">
          <strong>Autres dates de cet événement</strong>
          <ul class="list-unstyled mb-0 mt-2">
            {% for s in other_sessions %}
              <li class="py-1">
                <a href="{{ url_for('main.expo_detail', slug=s.slug) }}">{{ s.date_label }}</a>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    </div>

    <div class="col-lg-5">
      <div class="stat-tile text-start mb-3 p-0 overflow-hidden">
        <div class="p-3">
          {% if expo.venue_label %}<strong>{{ expo.venue_label }}</strong>{% endif %}
          {% if expo.address_line %}<p class="mb-1 muted small">{{ expo.address_line }}</p>{% endif %}
          {% if expo.museum %}
            <a class="small" href="{{ url_for('main.museum_detail', slug=expo.museum.slug) }}">Voir la fiche du musée →</a>
          {% endif %}
        </div>
        {% if expo.map_lat and expo.map_lon %}
          <div id="expo-map" style="height:240px"
               data-lat="{{ expo.map_lat }}" data-lon="{{ expo.map_lon }}"
               data-label="{{ expo.venue_name or expo.title }}"></div>
        {% endif %}
      </div>

      <div class="stat-tile text-start mb-3">
        <p class="mb-1"><strong>Dates</strong><br>{{ expo.date_label }}</p>

        <p class="mb-1"><strong>Horaires</strong><br>
          {% if expo.schedule_text %}
            {{ expo.schedule_text }}
            {% if expo.schedule_from_museum %}<span class="muted small d-block">Horaires du musée</span>{% endif %}
          {% else %}
            <span class="muted">Non communiqués, vérifie avant de te déplacer.</span>
          {% endif %}
          {% if expo.schedule_url %}
            <a class="small d-block" href="{{ expo.schedule_url }}" target="_blank" rel="noopener">Horaires du musée ↗</a>
          {% endif %}
        </p>

        <p class="mb-1"><strong>Tarif</strong><br>{{ price.label }}
          {% if price.note %}<span class="muted small d-block">{{ price.note }}</span>{% endif %}
        </p>
        <p class="mb-1"><strong>Réservation</strong><br>{{ expo.reservation_label }}</p>

        {# Billetterie : réservation de l'expo, à défaut le site officiel du
           musée. Aucun bouton si rien n'est exploitable (cf. getter `ticket`).
           Les deux boutons vivent dans un conteneur flex : sinon ils se
           suivent en ligne avec des marges hautes différentes, et ne sont pas
           alignés. #}
        {% if expo.ticket or expo.official_url %}
          <div class="d-flex flex-wrap align-items-stretch gap-2 mt-2">
            {% if expo.ticket %}
              <a class="btn btn-ink btn-sm" href="{{ expo.ticket.url }}" target="_blank" rel="noopener">{{ expo.ticket.label }} ↗</a>
            {% endif %}
            {% if expo.official_url %}
              <a class="btn btn-outline-ink btn-sm" href="{{ expo.official_url }}" target="_blank" rel="noopener">Page de l'exposition ↗</a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      {% if current_user.is_authenticated %}
        <form method="post" action="{{ url_for('main.toggle_favorite', expo_id=expo.id) }}" class="mb-2">
          <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
          <button class="btn {{ 'btn-ink' if is_fav else 'btn-outline-ink' }} w-100">
            {{ '★ Dans tes favoris' if is_fav else '☆ Ajouter aux favoris' }}
          </button>
        </form>

        <div class="stat-tile text-start">
          <strong>{{ 'Tu as fait cette expo' if visit else "Tu l'as faite ?" }}</strong>
          <form method="post" action="{{ url_for('main.mark_done', expo_id=expo.id) }}" class="mt-2" id="done-form">
            <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
            <div class="mb-2" id="star-picker">
              {% for i in range(1,6) %}
                <span class="star-input {{ 'active' if visit and visit.rating and i <= visit.rating else '' }}" data-val="{{ i }}">★</span>
              {% endfor %}
              <input type="hidden" name="rating" id="rating-input" value="{{ visit.rating or '' }}">
            </div>
            <textarea class="form-control mb-2" name="comment" rows="2" placeholder="Ton avis (optionnel)">{{ visit.comment or '' }}</textarea>
            <button class="btn btn-ink w-100">{{ 'Mettre à jour' if visit else 'Marquer comme faite' }}</button>
          </form>
          {% if visit %}
            <form method="post" action="{{ url_for('main.unmark_done', expo_id=expo.id) }}" class="mt-2">
              <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
              <button class="btn btn-link btn-sm muted p-0">Annuler la visite</button>
            </form>
          {% endif %}
        </div>
      {% else %}
        <div class="stat-tile">
          <p class="mb-2">Connecte-toi pour ajouter en favori, marquer comme faite et noter.</p>
          <a href="{{ url_for('auth.login') }}" class="btn btn-ink btn-sm">Connexion</a>
        </div>
      {% endif %}
    </div>
  </div>

  {# Signalement d'erreur : <details> plutôt qu'un modal, aucun JS nécessaire. #}
  <details class="report-box mt-5">
    <summary class="muted small">Une erreur sur cette fiche ? Signale-la</summary>
    <form method="post" action="{{ url_for('main.report_expo', expo_id=expo.id) }}" class="mt-3" style="max-width:520px">
      <input type="hidden" name="_csrf" value="{{ csrf_token() }}">

      {# Pot de miel : masqué en CSS, jamais rempli par un humain. #}
      <div class="hp-field" aria-hidden="true">
        <label>Ne pas remplir<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
      </div>

      <div class="mb-2">
        <label class="form-label small">Type de problème</label>
        <select class="form-select form-select-sm" name="problem">
          {% for key, label in report_problems %}
            <option value="{{ key }}">{{ label }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="mb-2">
        <label class="form-label small">Ce qui ne va pas *</label>
        <textarea class="form-control form-control-sm" name="message" rows="3" required
                  minlength="10" maxlength="2000"
                  placeholder="Ex. l'expo est terminée depuis le 3 mai, le lien de réservation ne marche plus…"></textarea>
      </div>
      <div class="mb-2">
        <label class="form-label small">Ton email <span class="muted">(facultatif)</span></label>
        <input type="email" class="form-control form-control-sm" name="email" maxlength="255">
      </div>
      <button class="btn btn-outline-ink btn-sm" data-busy="Envoi…">Envoyer le signalement</button>
    </form>
  </details>

  {% if reviews %}
    <h3 class="mt-5 mb-3">Avis ({{ reviews|length }})</h3>
    {% for r in reviews %}
      <div class="border-bottom py-2">
        <strong>{{ r.user.prenom }}</strong>
        {% if r.rating %}{{ stars(r.rating) }}{% endif %}
        <span class="muted small">{{ r.visited_at | dmy }}</span>
        {% if r.comment %}<p class="mb-0">{{ r.comment }}</p>{% endif %}
      </div>
    {% endfor %}
  {% endif %}
</div>
{% endblock %}

{% block scripts %}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script nonce="{{ csp_nonce }}">
  const mapEl = document.getElementById('expo-map');
  if (mapEl && window.L) {
    const lat = parseFloat(mapEl.dataset.lat), lon = parseFloat(mapEl.dataset.lon);
    const map = L.map(mapEl, { scrollWheelZoom: false }).setView([lat, lon], 15);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
      attribution: '© OpenStreetMap, © CARTO', maxZoom: 19
    }).addTo(map);
    L.marker([lat, lon]).addTo(map).bindPopup(mapEl.dataset.label);
  }

  const picker = document.getElementById('star-picker');
  if (picker) {
    const stars = picker.querySelectorAll('.star-input');
    const input = document.getElementById('rating-input');
    stars.forEach(star => {
      star.addEventListener('click', () => {
        const val = parseInt(star.dataset.val);
        input.value = val;
        stars.forEach(s => s.classList.toggle('active', parseInt(s.dataset.val) <= val));
      });
    });
  }
</script>
{% endblock %}
