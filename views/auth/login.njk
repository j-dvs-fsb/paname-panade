{% extends "base.njk" %}
{% block title %}Connexion | Paname Panade{% endblock %}
{% block content %}
<div class="container py-5" style="max-width:420px">
  <h1 class="mb-4">Connexion</h1>
  <form method="post">
    <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
    <div class="mb-3">
      <label class="form-label">Email</label>
      <input type="email" name="email" class="form-control" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Mot de passe</label>
      <input type="password" name="password" class="form-control" autocomplete="current-password" required>
    </div>
    <button class="btn btn-ink w-100">Se connecter</button>
  </form>

  <div class="text-center my-3 muted small">ou</div>
  {% if google_enabled %}
    <a class="btn btn-outline-ink w-100 mb-2" href="{{ url_for('auth.google') }}">Continuer avec Google</a>
  {% endif %}
  <button class="btn btn-outline-ink w-100" id="passkey-login">Se connecter avec une passkey</button>
  <p class="muted small mt-2 mb-0" id="passkey-status" role="status" aria-live="polite"></p>

  <p class="mt-3 muted">Pas de compte ? <a href="{{ url_for('auth.register') }}">Inscris-toi</a>.</p>
</div>
{% endblock %}

{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/@simplewebauthn/browser@13/dist/bundle/index.umd.min.js"></script>
<script nonce="{{ csp_nonce }}">
  // Cérémonie d'authentification : défi et vérification par le greffon passkey
  // de Better Auth, sur /api/auth/passkey/*. En cas de succès il pose lui-même
  // le cookie de session.
  const btn = document.getElementById('passkey-login');
  const status = document.getElementById('passkey-status');
  const say = (msg) => { status.textContent = msg; };

  btn.addEventListener('click', async () => {
    if (!window.SimpleWebAuthnBrowser) { say("Ce navigateur ne gère pas les passkeys."); return; }

    btn.disabled = true;
    say('Suis les instructions de ton appareil…');
    try {
      const optionsResponse = await fetch('/api/auth/passkey/generate-authenticate-options', {
        credentials: 'same-origin',
      });
      if (!optionsResponse.ok) throw new Error('options indisponibles');
      const optionsJSON = await optionsResponse.json();

      const assertion = await SimpleWebAuthnBrowser.startAuthentication({ optionsJSON });

      const verifyResponse = await fetch('/api/auth/passkey/verify-authentication', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ response: assertion }),
      });
      if (!verifyResponse.ok) throw new Error('passkey non reconnue');

      location.href = '{{ url_for("main.profile") }}';
    } catch (e) {
      btn.disabled = false;
      say(e.name === 'NotAllowedError'
        ? "Connexion annulée. Clique dans la page, puis réessaie."
        : "Échec de la connexion : " + (e.message || e.name));
    }
  });
</script>
{% endblock %}
