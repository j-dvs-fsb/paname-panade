{% extends "base.njk" %}
{% block title %}Connexion — Paname Panade{% endblock %}
{% block content %}
<div class="container py-5" style="max-width:420px">
  <h1 class="mb-4">Connexion</h1>
  <form method="post">
    <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
    <div class="mb-3">
      <label class="form-label">Email</label>
      <input type="email" name="email" class="form-control" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Mot de passe</label>
      <input type="password" name="password" class="form-control" autocomplete="current-password" required>
    </div>
    <button class="btn btn-ink w-100">Se connecter</button>
  </form>

  <div class="text-center my-3 muted small">— ou —</div>
  {% if google_enabled %}
    <a class="btn btn-outline-ink w-100 mb-2" href="{{ url_for('auth.google') }}">Continuer avec Google</a>
  {% endif %}
  <button class="btn btn-outline-ink w-100" id="passkey-login">🔑 Se connecter avec une passkey</button>

  <p class="mt-3 muted">Pas de compte ? <a href="{{ url_for('auth.register') }}">Inscris-toi</a>.</p>
</div>
{% endblock %}

{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/@simplewebauthn/browser@13/dist/bundle/index.umd.min.js"></script>
<script nonce="{{ csp_nonce }}">
  document.getElementById('passkey-login').addEventListener('click', async () => {
    if (!window.SimpleWebAuthnBrowser) { alert('Passkeys non supportées par ce navigateur.'); return; }
    const headers = { 'Content-Type': 'application/json', 'X-CSRF-Token': '{{ csrf_token() }}' };
    try {
      const options = await (await fetch('/connexion/passkey/options', {
        method: 'POST', headers, body: '{}'
      })).json();
      const authResp = await SimpleWebAuthnBrowser.startAuthentication({ optionsJSON: options });
      const out = await (await fetch('/connexion/passkey/verify', {
        method: 'POST', headers,
        body: JSON.stringify(authResp)
      })).json();
      if (out.ok) location.href = out.redirect;
      else alert('Échec : ' + (out.error || 'inconnu'));
    } catch (e) {
      alert('Annulé : ' + e.message);
    }
  });
</script>
{% endblock %}
