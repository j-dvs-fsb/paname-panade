{% macro stars(value) %}
  <span class="stars" title="{{ value }}/5">
    {%- for i in range(1, 6) -%}
      {{ '★' if value and i <= value else '☆' }}
    {%- endfor -%}
  </span>
{% endmacro %}

{# `eager` : à passer pour la première carte de la page - l'image est au-dessus
   de la ligne de flottaison, la charger paresseusement retarderait l'affichage.
   `user` : passé explicitement, une macro Nunjucks ne voit pas le contexte du
   template appelant - sans lui, le tarif serait toujours celui d'un anonyme. #}
{% macro expo_card(expo, eager=false, user=null) %}
  <div class="col-md-4 mb-4">
    <div class="card h-100">
      <div class="card-img-wrap">
        {% set img = img_url(expo.image) %}
        {% if img %}
          {# width/height explicites : la place est réservée avant le
             chargement, plus de saut de mise en page (CLS). #}
          <img src="{{ img }}" class="card-img-top" alt="{{ expo.title }}"
               width="400" height="170"
               loading="{{ 'eager' if eager else 'lazy' }}"
               {% if eager %}fetchpriority="high"{% endif %}
               decoding="async">
          {% if expo.is_current %}
            {# Voile de couleur (duotone) : réservé aux expos en cours. La
               couleur est attribuée par position via CSS (nth-child). #}
            <span class="card-tint" aria-hidden="true"></span>
          {% endif %}
        {% else %}
          <div class="card-img-placeholder">PP</div>
        {% endif %}
        {% if expo.is_permanent %}
          <span class="img-tag">Exposition permanente</span>
        {% endif %}
      </div>
      <div class="card-body d-flex flex-column">
        {% set price = price_for(expo, user) %}
        <span class="badge {{ 'badge-free' if price.free else 'badge-paid' }} mb-2 align-self-start">{{ price.badge }}</span>
        <h5 class="card-title">
          <a class="text-decoration-none" href="{{ url_for('main.expo_detail', slug=expo.slug) }}">{{ expo.title }}</a>
        </h5>
        {% if expo.museum %}
          <p class="muted small mb-1">{{ expo.museum.name }}</p>
        {% endif %}
        {% if not expo.is_permanent %}
          <p class="muted small mb-2">{{ expo.date_label }}</p>
        {% endif %}
        {% if expo.avg_rating %}
          <p class="mb-0">{{ stars(expo.avg_rating|round|int) }} <span class="muted small">({{ expo.rating_count }})</span></p>
        {% endif %}
      </div>
    </div>
  </div>
{% endmacro %}
