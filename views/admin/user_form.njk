{% extends "base.njk" %}
{% block title %}Admin · {{ u.prenom }}{% endblock %}
{% block content %}
<div class="container py-5" style="max-width:480px">
  <a href="{{ url_for('admin.users') }}" class="muted small">← Utilisateurs</a>
  <h1 class="mt-2 mb-4">{{ u.prenom }}</h1>
  <form method="post">
    <div class="mb-3">
      <label class="form-label">Prénom</label>
      <input type="text" name="prenom" class="form-control" value="{{ u.prenom or '' }}" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Email</label>
      <input type="email" name="email" class="form-control" value="{{ u.email or '' }}" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Date de naissance</label>
      <input type="date" name="date_naissance" class="form-control" value="{{ u.date_naissance or '' }}">
    </div>
    <div class="form-check mb-3">
      <input class="form-check-input" type="checkbox" name="is_admin" value="on" id="adm" {{ 'checked' if u.is_admin else '' }}>
      <label class="form-check-label" for="adm">Administrateur</label>
    </div>
    <div class="mb-3">
      <label class="form-label">Réinitialiser le mot de passe <span class="muted small">(laisser vide pour ne pas changer)</span></label>
      <input type="password" name="password" class="form-control" minlength="6">
    </div>
    <button class="btn btn-ink">Enregistrer</button>
    <a class="btn btn-link muted" href="{{ url_for('admin.users') }}">Annuler</a>
  </form>
</div>
{% endblock %}
