{% extends "base.njk" %}
{% block title %}Admin · Utilisateurs{% endblock %}
{% block content %}
<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Utilisateurs ({{ users|length }})</h1>
    <a class="btn btn-outline-ink btn-sm" href="{{ url_for('admin.dashboard') }}">← Dashboard</a>
  </div>

  <p class="muted small">
    Par minimisation des données (RGPD), seuls le prénom, l'email et le rôle sont visibles ici.
    Chaque membre gère lui-même ses informations, son mot de passe et ses passkeys.
  </p>

  <table class="table table-sm align-middle">
    <thead><tr><th>Prénom</th><th>Email</th><th>Inscrit le</th><th>Admin</th><th></th></tr></thead>
    <tbody>
      {% for u in users %}
        <tr>
          <td>{{ u.prenom }}</td>
          <td class="muted small">{{ u.email }}</td>
          <td class="muted small">{{ u.created_at | dmy }}</td>
          <td>{{ '✓' if u.is_admin else '-' }}</td>
          <td class="text-end text-nowrap">
            {% if u.id != current_user.id %}
              <form method="post" action="{{ url_for('admin.user_role', user_id=u.id) }}" class="d-inline"
                    data-confirm="{{ 'Retirer le rôle admin à ' if u.is_admin else 'Donner le rôle admin à ' }}{{ u.prenom }} ?">
                <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                <button class="btn btn-link btn-sm p-0 me-2">{{ 'Retirer admin' if u.is_admin else 'Rendre admin' }}</button>
              </form>
              <form method="post" action="{{ url_for('admin.user_delete', user_id=u.id) }}" class="d-inline"
                    data-confirm="Supprimer cet utilisateur et toutes ses données ?">
                <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                <button class="btn btn-link btn-sm p-0 text-danger">Suppr.</button>
              </form>
            {% else %}
              <span class="muted small">toi</span>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
