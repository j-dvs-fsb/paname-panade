{% extends "base.njk" %}
{% block title %}Admin · Éditer « {{ page.title }} » — Paname Panade{% endblock %}
{% block content %}
<div class="container py-5" style="max-width:920px">
  <a href="{{ url_for('admin.pages') }}" class="muted small">← Pages</a>
  <h1 class="mt-2 mb-1">{{ page.title }}</h1>
  <p class="muted small mb-4">Visible sur <a href="/{{ page.slug }}" target="_blank" rel="noopener">/{{ page.slug }}</a></p>

  <form method="post">
    <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
    <div class="mb-3">
      <label class="form-label">Titre *</label>
      <input class="form-control" name="title" value="{{ page.title }}" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Contenu</label>
      <textarea class="form-control font-monospace" name="content" rows="22"
                style="font-size:.85rem">{{ page.content }}</textarea>
      <div class="form-text">
        HTML autorisé : <code>&lt;p&gt;</code>, <code>&lt;h2 class="h5"&gt;</code>,
        <code>&lt;ul&gt;/&lt;li&gt;</code>, <code>&lt;strong&gt;</code>,
        <code>&lt;a href="…"&gt;</code>, <code>&lt;br&gt;</code>…
        Le rendu reprend la mise en page du site.
      </div>
    </div>

    <button class="btn btn-ink">Enregistrer</button>
    <a class="btn btn-link muted" href="{{ url_for('admin.pages') }}">Annuler</a>
  </form>
</div>
{% endblock %}
