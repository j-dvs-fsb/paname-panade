<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Paname Panade{% endblock %}</title>

  {# Métadonnées de référencement - construites par les routes via lib/seo.js.
     Une valeur par défaut est posée dans app.js pour qu'aucune page n'arrive
     ici sans description ni URL canonique. #}
  <meta name="description" content="{{ meta.description }}">
  <link rel="canonical" href="{{ meta.canonical }}">
  {% if meta.robots %}<meta name="robots" content="{{ meta.robots }}">{% endif %}
  <meta property="og:site_name" content="{{ meta.site_name }}">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:type" content="{{ meta.og_type }}">
  <meta property="og:title" content="{{ meta.title }}">
  <meta property="og:description" content="{{ meta.description }}">
  <meta property="og:url" content="{{ meta.url }}">
  <meta name="twitter:card" content="{{ 'summary_large_image' if meta.image else 'summary' }}">
  <meta name="twitter:title" content="{{ meta.title }}">
  <meta name="twitter:description" content="{{ meta.description }}">
  {% if meta.image %}
    <meta property="og:image" content="{{ meta.image }}">
    <meta property="og:image:alt" content="{{ meta.title }}">
    <meta name="twitter:image" content="{{ meta.image }}">
  {% endif %}

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="{{ url_for('static', filename='css/style.css') }}" rel="stylesheet">
  {% if meta.jsonld %}
    <script type="application/ld+json" nonce="{{ csp_nonce }}">{{ meta.jsonld | safe }}</script>
  {% endif %}
  {% block head %}{% endblock %}
</head>
<body>
  <nav class="navbar navbar-expand-lg sticky-top">
    <div class="container">
      <a class="logo navbar-brand" href="{{ url_for('main.index') }}">Paname <span>Panade</span></a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="nav">
        <ul class="navbar-nav me-auto">
          <li class="nav-item"><a class="nav-link" href="{{ url_for('main.expos') }}">Expositions</a></li>
          <li class="nav-item"><a class="nav-link" href="{{ url_for('main.museums') }}">Musées</a></li>
          <li class="nav-item"><a class="nav-link" href="{{ url_for('main.radar') }}">Radar</a></li>
          <li class="nav-item"><a class="nav-link" href="{{ url_for('main.random_expo') }}">Au hasard</a></li>
        </ul>
        <ul class="navbar-nav">
          {% if current_user.is_authenticated %}
            {% if current_user.is_admin %}
              <li class="nav-item"><a class="nav-link" href="{{ url_for('admin.dashboard') }}">Admin</a></li>
            {% endif %}
            <li class="nav-item"><a class="nav-link" href="{{ url_for('main.profile') }}">Profil ({{ current_user.prenom }})</a></li>
            <li class="nav-item">
              {# Le bouton porte .nav-link comme les liens voisins : avec
                 .btn.p-0 il perdait leur rembourrage vertical et remontait. #}
              <form method="post" action="{{ url_for('auth.logout') }}">
                <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                <button type="submit" class="nav-link nav-link-button">Déconnexion</button>
              </form>
            </li>
          {% else %}
            <li class="nav-item"><a class="nav-link" href="{{ url_for('auth.login') }}">Connexion</a></li>
            <li class="nav-item"><a class="nav-link" href="{{ url_for('auth.register') }}">Inscription</a></li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>

  <div class="container mt-3">
    {% for f in flashes %}
      <div class="alert alert-{{ f.category }} alert-dismissible fade show" role="alert">
        {{ f.message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    {% endfor %}
  </div>

  <main>
    {% block content %}{% endblock %}
  </main>

  <footer class="py-4 mt-5">
    <div class="container d-flex justify-content-between flex-wrap gap-2">
      <span><strong>Paname Panade</strong> - expos et musées gratuits pour les -26 ans à Paris</span>
      <nav class="footer-links">
        <a href="{{ url_for('main.suggest') }}">Suggérer une expo</a>
        <a href="{{ url_for('main.about') }}">À propos</a>
        <a href="{{ url_for('main.legal') }}">Mentions légales</a>
        <a href="{{ url_for('main.privacy') }}">Politique de confidentialité</a>
      </nav>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script nonce="{{ csp_nonce }}">
    // Remplace les gestionnaires inline (interdits par la CSP) :
    // data-confirm="…" -> confirmation avant envoi ; data-busy="…" -> bouton
    // désactivé pendant l'envoi ; data-autosubmit sur <select> -> envoi auto.
    document.addEventListener('submit', (e) => {
      const msg = e.target.getAttribute && e.target.getAttribute('data-confirm');
      if (msg && !window.confirm(msg)) { e.preventDefault(); return; }
      const busy = e.target.getAttribute && e.target.getAttribute('data-busy');
      if (busy) {
        const btn = e.target.querySelector('button[type=submit], button');
        if (btn) { btn.disabled = true; btn.textContent = busy; }
      }
    });
    document.addEventListener('change', (e) => {
      if (e.target.matches && e.target.matches('select[data-autosubmit]') && e.target.form) {
        e.target.form.submit();
      }
    });
  </script>
  {% block scripts %}{% endblock %}
</body>
</html>
