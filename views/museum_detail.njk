{% extends "base.njk" %}
{% from "_macros.njk" import expo_card %}
{% block title %}{{ museum.name }} | Paname Panade{% endblock %}
{% block content %}
<div class="container py-5">
  <a href="{{ url_for('main.museums') }}" class="muted small">← Tous les musées</a>
  <h1 class="mt-2">{{ museum.name }}</h1>
  <div class="mb-3">
    {% if museum.is_closed %}<span class="badge badge-paid">Fermé pour travaux</span>{% endif %}
    {% for label in museum.free_labels %}<span class="badge badge-free">{{ label }}</span> {% endfor %}
  </div>
  {% if museum.is_closed %}
    <div class="stat-tile text-start mb-3"><strong>Musée fermé</strong><br>{{ museum.closed_note }}</div>
  {% endif %}

  <div class="row mt-3">
    <div class="col-lg-8">
      {% if museum.description %}<p>{{ museum.description }}</p>{% endif %}
    </div>
    <div class="col-lg-4">
      <div class="stat-tile text-start">
        {% if museum.address %}<p class="mb-1"><strong>Adresse</strong><br>{{ museum.address }}</p>{% endif %}
        {% if museum.arrondissement %}<p class="mb-1 muted small">{{ museum.arrondissement }}</p>{% endif %}
        {% if museum.horaires %}<p class="mb-1 mt-2"><strong>Horaires</strong><br>{{ museum.horaires }}</p>{% endif %}
        {% if museum.horaires_url %}
          <a class="small d-block" href="{{ museum.horaires_url }}" target="_blank" rel="noopener">Horaires et infos pratiques ↗</a>
        {% endif %}
        {% if museum.website %}<a class="btn btn-outline-ink btn-sm mt-2" href="{{ museum.website }}" target="_blank" rel="noopener">Site officiel ↗</a>{% endif %}
      </div>
    </div>
  </div>

  {# Le contrôleur ne charge que les expos en cours (lib/visibility.js). #}
  {% set current = museum.expositions %}

  <h3 class="mt-5 mb-3">Expositions en cours</h3>
  <div class="row">
    {% for expo in current %}
      {{ expo_card(expo, loop.first, current_user) }}
    {% else %}
      <p class="muted">Pas d'exposition en cours pour ce musée.</p>
    {% endfor %}
  </div>

</div>
{% endblock %}
